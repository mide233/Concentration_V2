{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "cmake: build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cmake: build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Release"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "cmake: clean (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "clean"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "cubemx: patch",
            "type": "shell",
            "command": "python3",
            "args": [
                ".scripts/patch_cubemx"
            ],
            "problemMatcher": []
        },
        {
            "label": "flash (OpenOCD / ST-Link)",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "tools/openocd.cfg",
                "-c",
                "program build/Debug/Concentration_V2.elf verify reset exit"
            ],
            "problemMatcher": [],
            "dependsOn": "cmake: build (Debug)"
        },
        {
            "label": "erase (OpenOCD / ST-Link)",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "tools/openocd.cfg",
                "-c",
                "init; reset halt; stm32f1x mass_erase 0; reset run; shutdown"
            ],
            "problemMatcher": []
        }
    ]
}
